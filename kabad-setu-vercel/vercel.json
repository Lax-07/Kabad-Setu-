{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "python3 scripts/build_vercel.py",
  "outputDirectory": "public",
  "functions": {
    "api/handler.py": {
      "maxDuration": 60,
      "excludeFiles": "{static/**,public/**,data/**,tests/**,scripts/**,.venv/**,.env*,README.md,DEPLOYMENT.md}"
    }
  },
  "rewrites": [
    {"source": "/api/:path*", "destination": "/api/handler?_route=:path*"}
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "same-origin"},
        {"key": "Permissions-Policy", "value": "geolocation=(self), camera=(self), microphone=()"},
        {"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' data: blob:; media-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"}
      ]
    },
    {"source": "/models/:path*", "headers": [{"key": "Cache-Control", "value": "public, max-age=86400"}]},
    {"source": "/vendor/:path*", "headers": [{"key": "Cache-Control", "value": "public, max-age=86400"}]},
    {"source": "/api/:path*", "headers": [{"key": "Cache-Control", "value": "private, no-store"}]}
  ]
}
